D6E_AUTH_BASE_URL=https://auth.example.com
D6E_AUTH_CLIENT_ID=
D6E_AUTH_CLIENT_SECRET=
# Generate exactly 32 random bytes and encode them as base64. AES-GCM additional
# authenticated data separates operator sessions from recipient link sessions.
SESSION_ENCRYPTION_KEY=
# Optional retiring session key during rotation. Leave empty when unused.
SESSION_ENCRYPTION_KEY_PREVIOUS=
# Separate AES-256 key for short-lived recipient capabilities and completion tokens held by delivery outboxes.
# Do not rotate this MVP key until all rows carrying its key id have been delivered.
DELIVERY_ENCRYPTION_KEY=
# Optional retiring delivery key during rotation. Leave empty when unused.
DELIVERY_ENCRYPTION_KEY_PREVIOUS=
# Exact public HTTPS origin used to create recipient signing links and completion access links.
SIGNKIT_PUBLIC_ORIGIN=https://sign.example.com
# Transactional sender address and optional display name.
SIGNKIT_EMAIL_FROM=sign@sign.example.com
SIGNKIT_EMAIL_FROM_NAME=SignKit
# High-entropy bearer secret for the bounded delivery drain endpoints (/deliveries/drain, /completion-artifacts/drain, /completion-deliveries/drain).
DELIVERY_WORKER_SECRET=
# High-entropy bearer secret (min 32 printable ASCII chars) for one-time instance owner bootstrap (POST /api/v1/instance/bootstrap).
SIGNKIT_BOOTSTRAP_SECRET=
# Mail transport for invitation and completion delivery. Exactly two values are accepted:
#   smtp        - generic SMTP; use this for Resend and any other provider too, through its
#                 ordinary SMTP endpoint. Node/Docker and Vercel only.
#   cloudflare  - Cloudflare Email Sending: the REST API on Node/Docker and Vercel, or the
#                 native EMAIL binding on Cloudflare Workers.
# Node/Docker and Vercel: set this explicitly; there is no default. Cloudflare Workers:
# already set to `cloudflare` as a non-secret var in wrangler.jsonc/wrangler.build.jsonc,
# the only value that runtime supports.
SIGNKIT_MAIL_PROVIDER=

# Node / Docker profile
DATABASE_URL=postgres://signkit:change-me@postgres:5432/signkit
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=signkit
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most S3-compatible services require path-style requests. Set false for AWS S3.
S3_FORCE_PATH_STYLE=true

# Node / Docker and Vercel: required when SIGNKIT_MAIL_PROVIDER=smtp.
SIGNKIT_SMTP_HOST=
SIGNKIT_SMTP_PORT=587
# Required, exactly true or false; there is no default, and unset/blank fails closed.
# true = implicit TLS from connect (typically port 465). false = mandatory STARTTLS
# upgrade on connect (typically port 587); the send aborts if the server cannot
# upgrade. There is no setting that permits a plaintext connection.
SIGNKIT_SMTP_SECURE=false
# Optional; if set, both are required together. Leave both empty for an
# unauthenticated relay. The password is never trimmed — its exact bytes are sent as-is.
SIGNKIT_SMTP_USERNAME=
SIGNKIT_SMTP_PASSWORD=

# Node / Docker and Vercel: required when SIGNKIT_MAIL_PROVIDER=cloudflare.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
