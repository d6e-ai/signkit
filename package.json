{
	"name": "signkit",
	"private": true,
	"version": "0.1.6",
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@11.24.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:node": "DEPLOY_TARGET=node vite build",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
		"build:vercel": "DEPLOY_TARGET=vercel vite build",
		"deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy",
		"cf:typegen": "wrangler types src/worker-configuration.d.ts",
		"preview": "vite preview",
		"db:migrate:postgres": "node scripts/postgres-migrate.mjs",
		"db:migrate:postgres:check": "node scripts/postgres-migrate.mjs --check",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie baseLocale --emit-ts-declarations --silent",
		"clean:kit-build": "node ./scripts/clean-kit-build.mjs",
		"prepare": "pnpm run i18n:compile && svelte-kit sync",
		"check": "pnpm run i18n:compile && pnpm run clean:kit-build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --project server --project postgres",
		"test:browser": "node scripts/test-browser-guard.mjs",
		"test:node-build": "node scripts/test-node-build.mjs",
		"test:create-signkit": "pnpm --filter create-signkit test",
		"build:create-signkit": "pnpm --filter create-signkit build",
		"test": "pnpm run test:unit -- --run && pnpm run test:browser && pnpm run test:create-signkit"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260911.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.2",
		"@internationalized/date": "^3.12.4",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tabler/icons-svelte": "^3.46.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"hast-util-sanitize": "^5.0.2",
		"jsonc-parser": "^3.3.1",
		"npm": "12.0.2",
		"playwright": "^1.63.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.131.2"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1131.0",
		"fflate": "^0.8.3",
		"isomorphic-git": "^1.42.2",
		"jose": "^6.2.12",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.0.10",
		"pdfjs-dist": "^6.3.289",
		"postgres": "^3.4.9",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"uuid": "^14.0.2",
		"zod": "^4.6.2"
	}
}
